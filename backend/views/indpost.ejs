<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>here is post</h1>
    <p>Post id:<%= post.id %> </p>
    <div class="posts">
        <h1 class="username">@<%= post.username %> </h1>
        <h3 class="content"><%= post.content %> </h3>
        <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit Post</a>
        <a href="http://localhost:3000/posts">back to all posts</a>
    </div>
</body>
</html>