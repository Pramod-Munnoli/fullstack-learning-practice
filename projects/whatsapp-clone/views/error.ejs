<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Something Went Wrong</title>
    <!-- CDNs for Tailwind and Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div class="bg-red-50 p-10 rounded-3xl border border-red-100 shadow-xl max-w-lg">
        <div class="bg-red-500 text-white w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
            <i class="fa-solid fa-triangle-exclamation text-4xl"></i>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Oops! Something went wrong.</h1>
        <p class="text-lg text-slate-600 mb-8 font-medium"><%= message %></p>
        <a href="/chats" class="inline-block bg-[#ff385c] text-white px-8 py-3 rounded-full font-bold hover:bg-[#e31c5f] transition-all transform hover:scale-105">
            Back to Safety
        </a>
    </div>
</div>
</body>
</html>

