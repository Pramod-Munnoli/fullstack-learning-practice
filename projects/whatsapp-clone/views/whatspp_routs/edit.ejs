<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Edit the Chat</h1>
    <p>from:<%= chat.from %></p>
    <p>to:<%= chat.to %></p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="post" class="editbox" >
        <textarea name="msg" class="text"><%= chat.msg %></textarea>
        <button class="update">Update</button>
    </form>

</body>
</html>