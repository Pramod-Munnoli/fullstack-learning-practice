<% if(success && success.length) { %>
    <div class="bg-green-100 border border-green-400 text-green-700 pl-4 pr-12 py-3 rounded relative mb-4" role="alert">
        <span class="block sm:inline"><%= success %></span>
        <button class=" w-15 absolute top-0 bottom-0 right-0 px-4 py-3 text-green-700 hover:text-green-900 focus:outline-none" aria-label="Close"
         onclick="this.parentElement.style.display='none'">
            <span class="text-2xl leading-none">&times;</span>
        </button>
    </div>
<% } %>

<% if(error && error.length) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 pl-4 pr-12 py-3 rounded relative mb-4" role="alert">
        <span class="block sm:inline"><%= error %></span>
        <button class=" w-15 absolute top-0 bottom-0 right-0 px-4 py-3 text-red-700 hover:text-red-900 focus:outline-none" aria-label="Close"
         onclick="this.parentElement.style.display='none'">
            <span class="text-2xl leading-none">&times;</span>
        </button>
    </div>
<% } %>