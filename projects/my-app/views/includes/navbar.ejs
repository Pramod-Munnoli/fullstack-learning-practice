    <!-- Navbar -->
    <nav class="glass-nav sticky top-0 z-50 w-full py-4 px-4 md:px-12 flex items-center justify-between">
        <!-- Logo -->
        <a href="/listings" class="flex items-center gap-2 group">
            <div class="bg-primary p-2 rounded-xl text-white transform group-hover:rotate-12 transition-transform duration-300">
                <i class="fa-solid fa-compass text-xl"></i>
            </div>
            <span class="text-2xl font-bold tracking-tight text-primary">Wanderlust</span>
        </a>

        <!-- Search Bar (Desktop) -->
        <form action="/listings" method="GET" class="hidden md:flex items-center bg-white border border-gray-200 rounded-full py-1.5 px-4 shadow-sm hover:shadow-md transition-shadow">
            <input 
                type="text" 
                name="q" 
                placeholder="Search destinations" 
                class="outline-none text-sm font-medium w-48 lg:w-64 px-2"
                autocomplete="off"
            >
            <button type="submit" class="bg-primary p-2 rounded-full text-white ml-2 hover:bg-primary-hover transition-colors">
                <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </button>
        </form>

        <!-- Right Side Nav -->
        <div class="flex items-center gap-4">
            <a href="/listings" class="hidden sm:block text-sm font-semibold hover:bg-gray-100 py-2 px-4 rounded-full transition-colors">Explore</a>
            <a href="/listings/new" class="hidden sm:block text-sm font-semibold hover:bg-gray-100 py-2 px-4 rounded-full transition-colors font-['Outfit']">Host home</a>
            
            <!-- User Menu -->
            <div class="flex items-center gap-3 border border-gray-200 rounded-full py-1.5 px-3 hover:shadow-md transition-all cursor-pointer bg-white relative group">
                <i class="fa-solid fa-bars text-gray-600"></i>
                <div class="bg-gray-500 text-white rounded-full p-2 w-8 h-8 flex items-center justify-center">
                    <i class="fa-solid fa-user text-xs"></i>
                </div>

                <!-- Auth Dropdown Menu -->
                <div class="absolute right-0 top-full mt-2 w-56 bg-white border border-gray-100 rounded-2xl shadow-xl py-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-300 z-[100]">
                    <% if(!currUser) { %>
                        <a href="/signup" class="block px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">Sign up</a>
                        <a href="/login" class="block px-4 py-3 text-sm font-normal text-gray-700 hover:bg-gray-50 transition-colors">Log in</a>
                    <% } %>
                    <% if(currUser) { %>
                        <div class="px-4 py-3 border-b border-gray-100">
                            <p class="text-xs text-gray-500 mb-1">Signed in as</p>
                            <p class="text-sm font-semibold text-gray-800 truncate"><%= currUser.username %></p>
                        </div>
                        <a href="/logout" class="block px-4 py-3 text-sm font-normal text-red-600 hover:bg-red-50 transition-colors">Log out</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
