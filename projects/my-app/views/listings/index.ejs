<% layout("layouts/boilerplate") %> 
<div class="max-w-7xl mx-auto px-4 md:px-8 py-10">
    <!-- Filters Section -->
    <div class="mb-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div id="filters" class="flex items-center gap-8 overflow-x-auto pb-2 scrollbar-hide no-scrollbar flex-grow">
            <% const categories = [
                { name: "Trending", icon: "fire" },
                { name: "Rooms", icon: "bed" },
                { name: "Iconic Cities", icon: "mountain-city" },
                { name: "Mountains", icon: "mountain" },
                { name: "Castles", icon: "fort-awesome" },
                { name: "Amazing Pools", icon: "person-swimming" },
                { name: "Camping", icon: "campground" },
                { name: "Farms", icon: "wheat-awn" },
                { name: "Arctic", icon: "snowflake" },
                { name: "Domes", icon: "igloo" },
                { name: "Boats", icon: "ship" }
            ]; %>
            
            <% for(let cat of categories) { %>
                <a href="/listings?category=<%= cat.name %>" class="flex flex-col items-center gap-2 min-w-fit group cursor-pointer opacity-70 hover:opacity-100 transition-opacity <%= typeof category !== 'undefined' && category === cat.name ? 'opacity-100 border-b-2 border-slate-900 pb-1' : '' %>">
                    <div class="text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-<%= cat.icon %>"></i>
                    </div>
                    <span class="text-xs font-semibold whitespace-nowrap"><%= cat.name %></span>
                </a>
            <% } %>
        </div>

        <div class="flex items-center gap-4 border border-slate-200 p-4 rounded-2xl bg-white shadow-sm hover:shadow-md transition-shadow">
            <div class="form-check form-switch flex items-center gap-3">
                <label class="text-sm font-semibold text-slate-700 cursor-pointer" for="flexSwitchCheckDefault">Display total after taxes</label>
                <input class="w-10 h-5 bg-slate-200 rounded-full appearance-none cursor-pointer relative transition-all checked:bg-primary" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            </div>
        </div>
    </div>

    <div id="listings-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
    <% for(let listing of allListings) { %>
        <div class="group cursor-pointer" onclick="window.location.href='/listings/<%= listing._id %>'">
            <div class="relative aspect-[4/3] overflow-hidden rounded-2xl mb-3 shadow-sm group-hover:shadow-xl transition-all duration-300">
                <% if(listing.image && listing.image.url) { %>
                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-500">
                <% } %>
                <div class="absolute top-3 right-3 text-white">
                    <i class="fa-regular fa-heart text-xl drop-shadow-md"></i>
                </div>
            </div>
            <div class="flex flex-col">
                <div class="flex justify-between items-start">
                    <span class="font-bold text-slate-900 line-clamp-1"><%= listing.title %></span>
                    <span class="flex items-center gap-1 text-sm"><i class="fa-solid fa-star text-xs text-yellow-400"></i>4.9</span>
                </div>
                <span class="text-sm text-slate-500 mt-1"><%= listing.location %>, <%= listing.country %></span>
                <div class="mt-2 font-semibold text-slate-900">
                    &#8377; <% if(listing.price) { %><%= listing.price.toLocaleString("en-IN") %><% } else { %>0<% } %> <span class="font-normal text-slate-500">night</span>
                    <i class="tax-info text-sm text-primary font-medium ml-1 hidden"> &nbsp; +18% GST</i>
                </div>
            </div>
        </div>
    <% } %>
    </div>
</div>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("change", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (let info of taxInfo) {
                if (taxSwitch.checked) {
                    info.classList.remove("hidden");
                } else {
                    info.classList.add("hidden");
                }
            }
        });
    }
</script>