<% layout("layouts/boilerplate") %>
<div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <h1 class="text-4xl font-extrabold text-slate-900 mb-0">Discover Destinations</h1>
    <div class="flex gap-4">
        <button class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-xl shadow-sm hover:shadow-md transition-all text-sm font-semibold">
            <i class="fa-solid fa-sliders"></i> Filters
        </button>
    </div>
</div>

<div id="listings-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
  <% for(let listing of allListings) { %>
    <div class="group cursor-pointer" onclick="window.location.href='/listings/<%= listing._id %>'">
        <div class="relative aspect-square overflow-hidden rounded-2xl mb-3 shadow-sm group-hover:shadow-xl transition-all duration-300">
            <% if(listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-500">
            <% } %>
            <div class="absolute top-3 right-3 text-white">
                <i class="fa-regular fa-heart text-xl drop-shadow-md"></i>
            </div>
        </div>
        <div class="flex flex-col">
            <div class="flex justify-between items-start">
                <span class="font-bold text-slate-900 line-clamp-1"><%= listing.title %></span>
                <span class="flex items-center gap-1 text-sm"><i class="fa-solid fa-star text-xs"></i> 4.9</span>
            </div>
            <span class="text-sm text-slate-500 mt-1"><%= listing.location %>, <%= listing.country %></span>
            <div class="mt-2 font-semibold text-slate-900">
                &#8377; <% if(listing.price) { %><%= listing.price.toLocaleString("en-IN") %><% } else { %>0<% } %> <span class="font-normal text-slate-500">night</span>
            </div>
        </div>
    </div>
  <% } %>
</div>