<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
</head>
<body>
    <h1>Create new listing</h1>
    <form action="/listings/new" method="post">
        <input type="text"   name="listing[title]" placeholder="Enter Title" id=""><br><br>
        <textarea type="text"name="listing[description]" placeholder="Enter description" id=""></textarea><br><br>
        <input type="image" name="listing[image]" placeholder="Enter image url" id=""><br><br> 
        <input type="number" name="listing[price]" placeholder="Enter price" id=""><br><br> 
        <input type="text"   name="listing[country]" placeholder="Enter country" id=""><br><br>
        <input type="text"   name="listing[location]" placeholder="Enter location" id=""><br><br>
        <button type="submit">Add</button>
    </form>
</body>
</html>