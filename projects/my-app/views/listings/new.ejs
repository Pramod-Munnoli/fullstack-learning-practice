<% layout("/layouts/boilerplate") %>
<body class="container">
    <h1>Create New Listing</h1>
    <form action="/listings" method="post">
        <label for="title">Title</label>
        <input type="text"   name="listing[title]" id="title" placeholder="Enter Title">
        
        <label for="description">Description</label>
        <textarea required name="listing[description]" id="description" placeholder="Enter description"></textarea>
        
        <label for="image">Image URL</label>
        <input type="text"   name="listing[image][url]" id="image" placeholder="Enter image url">
        
        <div style="display: flex; gap: 1rem;">
            <div style="flex: 1;">
                <label for="price">Price</label>
                <input type="number" required name="listing[price]" id="price" placeholder="Enter price">
            </div>
            <div style="flex: 1;">
                <label for="country">Country</label>
                <input type="text" required name="listing[country]" id="country" placeholder="Enter country">
            </div>
        </div>

        <label for="location">Location</label>
    <input type="text" required name="listing[location]" id="location" placeholder="Enter location">
        
        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Add Listing</button>
    </form>
</body> 