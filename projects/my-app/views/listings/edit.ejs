<% layout("/layouts/boilerplate") %>

<div class="max-w-2xl mx-auto py-10">
    <div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
        <h1 class="text-3xl font-bold text-gray-800 mb-6 flex items-center gap-2">
            <i class="fa-solid fa-pen-to-square text-[#ff385c]"></i>
            Edit Listing
        </h1>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation space-y-6" enctype="multipart/form-data">
            
            <!-- Title Field -->
            <div class="space-y-1">
                <label for="title" class="block text-sm font-semibold text-gray-700">Title</label>
                <div class="relative">
                    <input type="text" name="listing[title]" id="title" required value="<%= listing.title %>"
                        class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]
                        invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500">
                    <i class="fa-solid fa-circle-check absolute right-4 top-1/2 -translate-y-1/2 text-green-500 opacity-0 peer-[.is-valid]:opacity-100 transition-opacity"></i>
                    <i class="fa-solid fa-circle-exclamation absolute right-4 top-1/2 -translate-y-1/2 text-red-500 opacity-0 peer-[.is-invalid]:opacity-100 transition-opacity"></i>
                </div>
                <p class="text-xs text-green-600 font-medium hidden peer-[.is-valid]:block">Looks good!</p>
                <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Please provide a valid title.</p>
            </div>

            <!-- Description Field -->
            <div class="space-y-1">
                <label for="description" class="block text-sm font-semibold text-gray-700">Description</label>
                <div class="relative">
                    <textarea name="listing[description]" id="description" required rows="4"
                        class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]
                        invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500"><%= listing.description %></textarea>
                </div>
                <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Description is required.</p>
            </div>

            <!-- Current Image Preview -->
            <div class="space-y-1">
                <p class="block text-sm font-semibold text-gray-700">Current Listing Image</p>
                <img src="<%= originalImageUrl %>" class="w-40 rounded-xl shadow-sm border border-gray-100" />
            </div>

            <!-- Image Upload Field -->
            <div class="space-y-1">
                <label for="image" class="block text-sm font-semibold text-gray-700">Upload New Image</label>
                <input type="file" name="listing[image]" id="image" 
                    class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]  
                    invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500">
            </div>

            <!-- Price and Country Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label for="price" class="block text-sm font-semibold text-gray-700">Price</label>
                    <input type="number" name="listing[price]" id="price" required min="0" value="<%= listing.price %>"
                        class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]
                        invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500">
                    <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Please enter a valid price.</p>
                </div>
                <div class="space-y-1">
                    <label for="country" class="block text-sm font-semibold text-gray-700">Country</label>
                    <input type="text" name="listing[country]" id="country" required value="<%= listing.country %>"
                        class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]
                        invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500">
                    <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Country name is required.</p>
                </div>
            </div>

            <!-- Category Field -->
            <div class="space-y-1">
                <label for="category" class="block text-sm font-semibold text-gray-700">Category</label>
                <select name="listing[category]" id="category" required
                    class="peer w-full px-4 py-3 bg-white text-gray-700 cursor-pointer rounded-xl border border-gray-200 outline-none appearance-none transition-all hover:bg-gray-50 hover:border-gray-300 focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c] focus:bg-white invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500"
                    style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23374151%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 1rem top 50%; background-size: 0.65rem auto;">
                    <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                    <option value="Rooms" <%= listing.category === "Rooms" ? "selected" : "" %>>Rooms</option>
                    <option value="Iconic Cities" <%= listing.category === "Iconic Cities" ? "selected" : "" %>>Iconic Cities</option>
                    <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                    <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
                    <option value="Amazing Pools" <%= listing.category === "Amazing Pools" ? "selected" : "" %>>Amazing Pools</option>
                    <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
                    <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
                    <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                    <option value="Domes" <%= listing.category === "Domes" ? "selected" : "" %>>Domes</option>
                    <option value="Boats" <%= listing.category === "Boats" ? "selected" : "" %>>Boats</option>
                </select>
                <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Please select a category.</p>
            </div>

            <!-- Location Field -->
            <div class="space-y-1">
                <label for="location" class="block text-sm font-semibold text-gray-700">Location</label>
                <input type="text" name="listing[location]" id="location" required value="<%= listing.location %>"
                    class="peer w-full px-4 py-3 rounded-xl border border-gray-200 outline-none transition-all focus:ring-2 focus:ring-[#ff385c]/20 focus:border-[#ff385c]
                    invalid:[&.is-invalid]:border-red-500 valid:[&.is-valid]:border-green-500">
                <p class="text-xs text-red-600 font-medium hidden peer-[.is-invalid]:block">Location is required.</p>
            </div>

            <button type="submit" 
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6 rounded-xl transition-all active:scale-95 shadow-lg shadow-blue-100">
                Update Listing
            </button>
        </form>
    </div>
</div>  